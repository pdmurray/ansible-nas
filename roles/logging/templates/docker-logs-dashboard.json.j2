{% set dashboard_error_query = 'sum by (container) (count_over_time({source="docker", container=~"$container"} |~ ' ~ (logging_error_pattern | to_json) ~ ' [$__auto]))' %}
{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "description": "Current state of the provisioned Docker log alert. No notification contact point is required.",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "id": 3,
      "options": {
        "alertName": "Error-like Docker logs detected",
        "dashboardAlerts": false,
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 5,
        "showInactiveAlerts": true,
        "sortOrder": 1,
        "stateFilter": {"error": true, "firing": true, "noData": true, "normal": true, "pending": true, "recovering": true},
        "viewMode": "list"
      },
      "title": "Docker log alert status",
      "type": "alertlist"
    },
    {
      "datasource": {"type": "loki", "uid": "ansible-nas-loki"},
      "description": "Count of log lines matching the configured error pattern.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "ansible-nas-loki"},
          "editorMode": "code",
          "expr": {{ dashboard_error_query | to_json }},
          "legendFormat": "{{ '{{container}}' }}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Error-like logs by container",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "ansible-nas-loki"},
      "gridPos": {"h": 16, "w": 24, "x": 0, "y": 12},
      "id": 2,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "ansible-nas-loki"},
          "editorMode": "code",
          "expr": "{source=\"docker\", container=~\"$container\"} |~ `${search:raw}`",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Docker logs",
      "type": "logs"
    }
  ],
  "schemaVersion": 41,
  "tags": ["ansible-nas", "docker", "logs"],
  "templating": {
    "list": [
      {
        "current": {"text": "All", "value": ".*"},
        "datasource": {"type": "loki", "uid": "ansible-nas-loki"},
        "definition": "label_values({source=\"docker\"}, container)",
        "includeAll": true,
        "label": "Container",
        "name": "container",
        "query": "label_values({source=\"docker\"}, container)",
        "refresh": 2,
        "type": "query"
      },
      {
        "current": {"text": {{ logging_error_pattern | to_json }}, "value": {{ logging_error_pattern | to_json }}},
        "label": "Search regex",
        "name": "search",
        "options": [],
        "query": {{ logging_error_pattern | to_json }},
        "type": "textbox"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Docker Logs",
  "uid": "ansible-nas-docker-logs",
  "version": 1
